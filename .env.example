# ── Google Cloud ──────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_REGION=us-central1
FIREBASE_PROJECT_ID=

# ── OAuth (Gmail connect flow — separate from app sign-in) ────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# Comma-separated Google Workspace domain allowlist for app sign-in.
# Each domain becomes its OWN isolated organization (separate admin, team,
# and settings). The FIRST domain listed is the "primary" tenant and maps to
# the existing default org — keep it first so nothing migrates. Example:
#   alpinefundings.com,everestbusinessfunding.com
ALLOWED_GOOGLE_WORKSPACE_DOMAIN=
# Keep "allowlist" in production until Google OAuth verification and CASA are
# complete. "open" creates isolated Solo workspaces for consumer accounts.
SIGNUP_MODE=allowlist

# 32+ char random string; used for session cookie signing
SESSION_SECRET=

# ── Token encryption ──────────────────────────────────────────
# Full KMS key resource name:
# projects/PROJECT/locations/LOC/keyRings/RING/cryptoKeys/KEY
TOKEN_KMS_KEY_RESOURCE=
# Local development ONLY: base64 32-byte AES key used when
# TOKEN_KMS_KEY_RESOURCE is unset. Never set in production.
LOCAL_DEV_ENCRYPTION_KEY=

# ── Cloud Tasks ───────────────────────────────────────────────
CLOUD_TASKS_QUEUE=campaign-sends
CLOUD_TASKS_SERVICE_ACCOUNT=
CLOUD_TASKS_WORKER_AUDIENCE=

# ── App ───────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
DEFAULT_ORGANIZATION_NAME=

# Who operates the platform: comma-separated emails that unlock /owner. Unset
# means the portal does not exist on this deployment. Deliberately configuration
# rather than a database collection, so nothing inside the app can grant platform
# control: see lib/platform/operators.ts.
PLATFORM_OWNER_EMAILS=

# Lead sourcing. Unset means the Find leads page says it is not configured and
# nothing can be searched; importing a list still works. This is the only key
# here that costs money per row, which is why SOURCING_MONTHLY_CREDITS exists.
APOLLO_API_KEY=
SOURCING_MONTHLY_CREDITS=250

# Optional structured-error alert destination. Never include a secret-bearing
# URL in source control; configure the real value in Cloud Run.
ERROR_WEBHOOK_URL=

# ── Support ──────────────────────────────────────────────────
# Published support address, shown on the public /support page and in the
# legal footer. This is the only path open to a customer who cannot sign in,
# so it must be a real monitored mailbox before self-service launch. Left
# empty, /support says no address is published yet rather than rendering a
# mailto that goes nowhere.
SUPPORT_EMAIL=
# Optional chat webhook pinged when a support request arrives. Without it,
# requests are recorded in the supportRequests collection only, which needs
# someone to remember to look.
SUPPORT_WEBHOOK_URL=

# ── Billing (optional; disabled when secret key is empty) ─────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_TEAM=

# ── AI writing (optional; disabled when key is empty) ─────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Email safety ──────────────────────────────────────────────
# Sending mode is controlled IN-APP by an admin (Administration →
# Sending mode), defaulting to TEST. In test mode every outbound email is
# redirected to TEST_EMAIL_DESTINATION with a [TEST] subject.
TEST_EMAIL_DESTINATION=
# Optional deployment lock: set to "true" on staging to force test mode and
# DISABLE the in-app live switch. Leave empty in production so the admin
# controls sending from the app. (Legacy TEST_MODE=true still acts as a lock.)
FORCE_TEST_MODE=

# ── Firebase web SDK (client, public) ─────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
